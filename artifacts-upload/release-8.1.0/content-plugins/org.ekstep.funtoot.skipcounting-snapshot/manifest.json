{
    "id": "org.ekstep.funtoot.skipcounting",
    "ver": "1.0",
    "author": "Sandhya M",
    "title": "Skip Counting",
    "description": "",
    "publishedDate": "",
    "editor": {
        "main": "editor/plugin.js",
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "wizard": {
            "controller": "editor/skip.counting.js",
            "template": "editor/skip.counting.html"
        },
        "assets": {
            "fabricImgPath": "/editor/assets/skipcounting.png"
        },
        "menu": [
            {
                "id": "skip.counting",
                "category": "main",
                "type": "icon",
                "toolTip": "Add Skip Counting",
                "title": "skip-counting",
                "iconClass": "icon-readalong icon",
                "onclick": {
                    "id": "org.ekstep.funtoot.skipcounting:showpopup"
                }
            }
        ],
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
                "dataType": "rangeslider",
                "valueType": "text",
                "required": true,
                "minimumValue": 1,
                "maximumValue": 10
            }
        ]
    },
    "renderer": {
        "main": "renderer/skipcounting.js",
        "dependencies": [
            {
                "id": "candy",
                "src": "asset/candy.png",
                "type": "image"
            }
        ]
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.funtoot.common",
            "ver": "1.0",
            "type": "plugin",
            "scope": "all"
        }
    ]
}