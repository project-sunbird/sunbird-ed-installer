{
    "id": "org.ekstep.plugins.funtoot.activitybase",
    "ver": "1.0",
    "author": "Amulya",
    "type": "plugin",
    "title": "funtoot Activity",
    "description": "funtoot Activity",
    "editor": {
        "main": "editor/plugin.js",
        "wizard": {
            "controller": "editor/activitybase.js",
            "template": "editor/activitybase.html",
            "filter": "editor/filters.json"
        },
        "menu": [],
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
                "dataType": "rangeslider",
                "valueType": "text",
                "required": true,
                "minimumValue": 1,
                "maximumValue": 10
            }
        ]
    },
    "renderer": {
        "main": "renderer/plugin.js"
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.funtoot.common",
            "ver": "1.0",
            "type": "plugin",
            "scope": "all"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.fibwordproblem",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.genericfib",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.genericmfr",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.genericmdd",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.genericmcq",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.genericmtf",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        },
        {
            "plugin": "org.ekstep.plugins.funtoot.genericseq",
            "ver": "1.0",
            "type": "plugin",
            "scope": "renderer"
        }
    ]
}