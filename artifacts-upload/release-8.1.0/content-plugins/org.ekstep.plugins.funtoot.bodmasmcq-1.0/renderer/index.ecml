ers","title":"Arrange the numbers","question_audio":"","question_image":"","model":{"numbers":"$nums","numericLangId":"en","langId":"en","numberType":"","hintMsg":"HINT051_VALUE","variables":{"$x":"generateNumber('[1 - 2]')","$y":"generateNumber('[3 - 4]')","$z":"generateNumber('[5 - 6]')","$a":"generateNumber('[6 - 7]')","$b":"generateNumber('[8 - 9]')","$n1":"10*$x+$b","$n2":"10*$y+$b","$n3":"10*$z+$b","$n4":"10*$a+$b","$n5":"10*$b+$b"}},"concepts":{"identifier":"C6","name":"Counting"}}]},"i18n":{"en":{"GENERIC_ERROR":"Look at the number sequence carefully and write the missing number.","EVEN_ARRAY_NOT_MASKED_ALTERNATELY":"Look at the difference between the given even numbers and carefully find the missing numbers.","ODD_ARRAY_NOT_MASKED_ALTERNATELY":"Look at the difference between the given numbers and carefully find the missing numbers.","ARRAY_WHICH_IS_MULTIPLE_OF_SKIP_NUMBER":"Look at the difference between the given numbers and carefully find the multiples of the missing numbers.","ARRAY_WHICH_IS_NOT_MULTIPLE_OF_SKIP_NUMBER":"Look at the difference between the given numbers and carefully find the missing numbers.","NO_ANSWER":"Please answer.","NO_HINT":"There is no hint for this question.","HINT051_VALUE":"Check the place value of each digit in the numbers and then carefully order them in sequence.","QUESTION05_STEM":"Rearrange the given numbers in ascending / descending order.","GREATER_THAN_9999_ASCENDING":"Check the place value of the given numbers and carefully arrange them in increasing order.","GREATER_THAN_9999_DESCENDING":"Check the place value of the given numbers and carefully arrange them in decreasing order.","LESSER_THAN_9999_ASCENDING":"Use the number sequence and arrange them in increasing order carefully.","LESSER_THAN_9999_DESCENDING":"Take the given number sequence and carefully arrange them in decreasing order."},"kn":{"GENERIC_ERROR":"ಎಚ್ಚರಿಕೆಯಿಂದ ಸಂಖ್ಯೆ ಅನುಕ್ರಮ ನೋಡಲು ಮತ್ತು ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಯನ್ನು ಬರೆಯಿರಿ.","EVEN_ARRAY_NOT_MASKED_ALTERNATELY":"ನೀಡಿದ ಸಹ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು.","ODD_ARRAY_NOT_MASKED_ALTERNATELY":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು.","ARRAY_WHICH_IS_MULTIPLE_OF_SKIP_NUMBER":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ದ್ವಿಗುಣ ಹೇಗೆ.","ARRAY_WHICH_IS_NOT_MULTIPLE_OF_SKIP_NUMBER":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು.","NO_ANSWER":"ದಯವಿಟ್ಟು ಉತ್ತರಿಸಿ.","NO_HINT":"ಈ ಪ್ರಶ್ನೆಗೆ ಯಾವುದೇ ಸುಳಿವು ಇಲ್ಲ.","HINT031_SKIPCOUNT":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ನಂತರ ಕಾಣೆಯಾಗಿದೆ ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಲೆಕ್ಕಾಚಾರ.","QUESTION03_STEM1":"ಖಾಲಿ ಸ್ಥಾನಗಳು ಎಣಿಕೆಯ ಫಿಲ್ ತೆರಳಿ ಬಳಸಿ"},"hi":{"GENERIC_ERROR":"नंबर अनुक्रम को सावधानी से देखो और लापता संख्या लिखें।","EVEN_ARRAY_NOT_MASKED_ALTERNATELY":"दी गई संख्याओं के बीच के अंतर को देखो और ध्यान से लापता संख्याओं को ढूंढें।","ODD_ARRAY_NOT_MASKED_ALTERNATELY":"दिए गए संख्याओं के बीच के अंतर को देखें और लापता संख्याओं को ध्यान से ढूंढें।","ARRAY_WHICH_IS_MULTIPLE_OF_SKIP_NUMBER":"दी संख्याओं के बीच के अंतर को देखें और ध्यान से गुम संख्याओं के गुणकों को ढूंढें।","ARRAY_WHICH_IS_NOT_MULTIPLE_OF_SKIP_NUMBER":"दिए गए संख्याओं के बीच के अंतर को देखें और लापता संख्याओं को ध्यान से ढूंढें।","NO_ANSWER":"कृपया उत्तर दीजिये।","NO_HINT":"इस सवाल का कोई संकेत नहीं है","HINT031_SKIPCOUNT":"दिए गए संख्याओं के बीच अंतर की जांच करें और फिर याद किए गए छोड़े गए नंबरों की गणना करें।","QUESTION03_STEM1":"रिक्त संख्या में भरने के लिए छोड़ने का उपयोग करना"}},"selectedConfig":{"Type":"Ordering numbers","Grade":"1, 2","Level":0,"LevelDesc":"Ordering 2 digit numbers","SubLevel":0,"SubLevelDesc":"2 digit numbers with the same units digit","Expression":"$x = [1 - 2]\n$y = [3 - 4]\n$z = [5 - 6]\n$a = [6 - 7]\n$b = [8 - 9]\n$n1= 10*$x+$b\n$n2=10*$y+$b\n$n3=10*$z+$b\n$n4=10*$a+$b\n$n5=10*$b+$b","BTLO":"R","DifficultyLevel":1,"Description":"Tests the identification of the sequence of 2 digit numbers with the same units digit.","SubLevelDesc1":"2 digit numbers [xy, x varies, y is fixed]","HintID":"HINT051_VALUE","QuestionText":"QUESTION05_STEM","QID":"","Subject":"NUM","selectedGrade":"1","QCount":3}}]]>
