{
    "id": "org.ekstep.wordconnectplay",
    "ver": "1.0",
    "author": "Ramakrishnan K",
    "title": "Word Connect Game - Play Plugin",
    "description": "Word Connect Game displays a word and its related and unrelated words for user to make connections.",
    "publishedDate": "01-11-2017",
    "editor": {
        "main": "editor/plugin.js",
        "dependencies": [
            { "type": "css", "src": "editor/libs/spinkit.css" },
            { "type": "css", "src": "editor/libs/please-wait.css" },
            { "type": "js", "src": "editor/libs/please-wait.min.js" },
            { "type": "css", "src": "editor/libs/semantic-ui-alert.css" },
            { "type": "js", "src": "editor/libs/jquery-ui.js" },
            { "type": "js", "src": "editor/libs/d3.min.js" },
            { "type": "js", "src": "editor/libs/semantic.min.js" },
            { "type": "js", "src": "editor/libs/semantic-ui-alert.js" },
            { "type": "js", "src": "editor/libs/browser.js" },  
            { "type": "js", "src": "editor/libs/fabric.js" },       
            { "type": "js", "src": "editor/libs/2d.js" },
            { "type": "js", "src": "editor/libs/line.arrow.js" },
            { "type": "js", "src": "editor/libs/arrow.head.js" },
            { "type": "js", "src": "editor/libs/word-connect-api.js" },
            { "type": "css", "src": "editor/wordconnectplay.css" }
        ],
        "container": [{
            "id": "play",
            "templateURL": "editor/wordconnectplay.html",
            "controllerURL": "editor/wordconnectplay.js"
        }]
    }
}
