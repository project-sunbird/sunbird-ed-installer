{
    "id": "org.ekstep.plugins.wordmaker",
    "ver": "1.0",
    "author": "Abha Singh",
    "title": "Wordmaker",
    "description": "This plugin is used to create word maker for set of words with given user configuration.",
    "icon": "assets/icon.png",
    "languages": ["English"],
    "categories": ["learning"],
    "keywords": ["Wordmaker"],
    "publishedDate": "",
    "editor": {
        "main": "editor/plugin.js",
        "dependencies": [
            { "type": "js", "src": "editor/init.js" },
            { "type": "js", "src": "editor/promisifier.js" },
            { "type": "js", "src": "editor/syllable-search-service.js" },
            { "type": "js", "src": "editor/wordmaker-syllable-service.js" },
            { "type": "js", "src": "editor/wordmaker-editor-app.js" },
            { "type": "plugin", "plugin": "org.ekstep.plugins.wordpicker", "ver": "1.0" }

        ],
        "menu": [{
            "id": "wordmaker",
            "category": "main",
            "type": "image",
            "toolTip": "Add Word Maker",
            "title": "wordmakerEditor",
            "iconImage": "assets/word.svg",
            "onclick": {
                "id": "org.ekstep.plugins.wordmaker:showpopup",
                "data": {
                    "type": "roundrect",
                    "x": 5,
                    "y": 5,
                    "fill": "#0000",
                    "w": 90,
                    "h": 90,
                    "radius": 10,
                    "stroke": "rgba(255, 255, 255, 255)",
                    "strokeWidth": 1,
                    "opacity": 0.01
                }
            }
        }],
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "init-data": {
            "type": "rect",
            "x": 10,
            "y": 10,
            "w": 80,
            "h": 80,
            "fill": "#DCDCDC"
        }
    },
    "renderer": {
        "main": "renderer/plugin.js"
    },
    "dependencies": [
        { "plugin": "org.ekstep.plugins.common.keyboard", "ver": "1.0", "scope": "renderer" },
        { "plugin": "org.ekstep.plugins.common.eraser", "ver": "1.0", "scope": "renderer" }
    ]
}
