}]},"i18n": {
    "en": {
        "ENTERED_SUCCESSOR_INSTEAD_OF_PREDECESSOR": "This is the number that comes after the given number. Recall the number series and find the number that comes before the given number.",
        "ENTERED_PREDECESSOR_INSTEAD_OF_SUCCESSOR": "This is the number that comes before the given number. Recall the number series and find the number that comes after the given number.",
        "WRONG_PREDECESSOR": "Recall the number sequence and find the correct number that comes before the given number.",
        "WRONG_SUCCESSOR": "Recall the number sequence and find the correct number that comes after the given number.",
        "WRONG_MIDDLE_NUMBER": "Recall the number sequence and find the correct number that comes between the given numbers.",
        "NO_ANSWER": "Please answer.",
        "NO_HINT": "There is no hint for this question",
        "HINT021_INITIAL_SUCCESSOR_PREDECESSOR": "Recall the sequence of counting numbers one by one from 1 to 5.",
        "HINT022_INITIAL_SUCCESSOR_PREDECESSOR": "Recall the sequence of counting numbers one by one from 6 to 9.",
        "HINT023_LEADINGZERO": "Remember that zeroes on the left side have no value.",
        "HINT024_SUCCESSOR": "Recall the sequence of counting numbers and identify the number which comes next.",
        "HINT025_PREDECESSOR": "Recall the sequence of counting numbers and identify the number which comes before.",
        "HINT026_INITIAL_NIB": "Recall counting numbers one by one from 1 to 10.",
        "HINT027_NIB": "Recall the sequence of counting numbers and find the missing number.",
        "QUESTION02_STEM1": "Write which number comes next to the given number"
    },
    "kn": {
        "ENTERED_SUCCESSOR_INSTEAD_OF_PREDECESSOR": "ಈ ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ನಂತರ ಬರುತ್ತದೆ ಸಂಖ್ಯೆ. ಸಂಖ್ಯೆಯು ಸರಣಿ ನೆನಪಿಸಿಕೊಂಡು ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ಮೊದಲು ಬರುತ್ತದೆ ಎಂದು ಹೇಗೆ.",
        "ENTERED_PREDECESSOR_INSTEAD_OF_SUCCESSOR": "ಈ ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ಮೊದಲು ಬರುತ್ತದೆ ಸಂಖ್ಯೆ. ಸಂಖ್ಯೆಯು ಸರಣಿ ನೆನಪಿಸಿಕೊಂಡು ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ನಂತರ ಬರುತ್ತದೆ ಎಂದು ಹೇಗೆ.",
        "WRONG_PREDECESSOR": "ಸಂಖ್ಯೆ ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಂಡು ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ಮೊದಲು ಬರುತ್ತದೆ ಸರಿಯಾದ ಸಂಖ್ಯೆಯನ್ನು ಕಂಡು.",
        "WRONG_SUCCESSOR": "ಸಂಖ್ಯೆ ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಂಡು ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ನಂತರ ಬರುತ್ತದೆ ಸರಿಯಾದ ಸಂಖ್ಯೆಯನ್ನು ಕಂಡು.",
        "WRONG_MIDDLE_NUMBER": "ಸಂಖ್ಯೆ ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಂಡು ಕೊಟ್ಟಿರುವ ಸಂಖ್ಯೆಗಳನ್ನು ನಡುವೆ ಬರುತ್ತದೆ ಸರಿಯಾದ ಸಂಖ್ಯೆಯನ್ನು ಕಂಡು.",
        "NO_ANSWER": "ದಯವಿಟ್ಟು ಉತ್ತರಿಸಿ.",
        "NO_HINT": "ಈ ಪ್ರಶ್ನೆಗೆ ಯಾವುದೇ ಸುಳಿವು ಇಲ್ಲ.",
        "HINT021_INITIAL_SUCCESSOR_PREDECESSOR": "1 ರಿಂದ 5 ರವರೆಗಿನ ಒಂದು ಸಂಖ್ಯೆಗಳು ಒಂದು ಲೆಕ್ಕ ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.",
        "HINT022_INITIAL_SUCCESSOR_PREDECESSOR": "6 ರಿಂದ 9 ಒಂದು ಸಂಖ್ಯೆಗಳು ಒಂದು ಲೆಕ್ಕ ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.",
        "HINT023_LEADINGZERO": "ಎಡಭಾಗದಲ್ಲಿ ಸೊನ್ನೆಗಳ ಮೌಲ್ಯವನ್ನು ಹೊಂದಿರುವ ನೆನಪಿಡಿ.",
        "HINT024_SUCCESSOR": "ಎಣಿಕೆಯ ಸಂಖ್ಯೆಗಳನ್ನು ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಂಡು ಮುಂದಿನ ಬರುವಂತಹ ಗುರುತಿಸಲು.",
        "HINT025_PREDECESSOR": "ಎಣಿಕೆಯ ಸಂಖ್ಯೆಗಳನ್ನು ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಂಡು ಮೊದಲು ಬರುವಂತಹ ಗುರುತಿಸಲು.",
        "HINT026_INITIAL_NIB": "10 1 ರಿಂದ ಒಂದು ಸಂಖ್ಯೆಗಳು ಒಂದು ಲೆಕ್ಕ ನೆನಪಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.",
        "HINT027_NIB": "ಎಣಿಕೆಯ ಸಂಖ್ಯೆಗಳನ್ನು ಅನುಕ್ರಮ ನೆನಪಿಸಿಕೊಂಡು ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಯನ್ನು ಕಂಡು.",
        "QUESTION02_STEM1": " ಇದು ಬರೆಯಿರಿ ಸಂಖ್ಯೆಯನ್ನು ನೀಡಲಾಗುವುದು ಸಂಖ್ಯೆಗೆ ಮುಂದಿನ ಬರುತ್ತದೆ"
    }
}}]]>
