{
    "id": "org.ekstep.funtoot.multiplicationtable",
    "ver": "1.0",
    "author": "Swathi",
    "type": "plugin",
    "title": "Multiplication Table",
    "description": "Multiplication Table",
    "editor": {
        "main": "editor/plugin.js",
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "wizard": {
            "controller": "editor/multiplicationtable.js",
            "template": "editor/multiplicationtable.html"
        },
        "assets": {
            "fabricImgPath": "/editor/assets/multiplicationtable.png"
        },
        "menu": [
            {
                "id": "multiplicationtable",
                "category": "main",
                "type": "icon",
                "toolTip": "Add Multiplication Table",
                "title": "Multiplication Table",
                "iconClass": "icon-readalong icon",
                "onclick": {
                    "id": "org.ekstep.funtoot.multiplicationtable:showpopup"
                }
            }
        ],
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
                "dataType": "rangeslider",
                "valueType": "text",
                "required": true,
                "minimumValue": 1,
                "maximumValue": 10
            }
        ]
    },
    "renderer": {
        "main": "renderer/plugin.js",
        "dependencies": []
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.funtoot.common",
            "ver": "1.0",
            "type": "plugin",
            "scope": "all"
        }
    ],
    "icon": "assets/icon.png",
    "languages": [
        "English"
    ],
    "categories": [
        ""
    ],
    "keywords": [
        ""
    ]
}