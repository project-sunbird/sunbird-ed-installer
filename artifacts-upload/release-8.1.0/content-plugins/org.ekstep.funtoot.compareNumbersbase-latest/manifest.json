                "type": "image",
                "preload": true
            },
            {
                "id": "lhsBg",
                "src": "asset/lhsbg.png",
                "type": "image",
                "preload": true
            },
            {
                "id": "greater",
                "src": "asset/greater-than.png",
                "type": "image",
                "preload": true
            },
            {
                "id": "equal",
                "src": "asset/equal.png",
                "type": "image",
                "preload": true
            }
        ]
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.funtoot.common",
