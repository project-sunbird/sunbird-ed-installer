{
    "id": "org.ekstep.funtoot.compareNumbersbase",
    "ver": "1.0",
    "author": "Amulya",
    "title": "Compare Numbers",
    "description": "",
    "publishedDate": "",
    "editor": {
        "main": "editor/plugin.js",
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "wizard": {
            "controller": "editor/comparenumbersbase.js",
            "template": "editor/comparenumbersbase.html"
        },
        "assets": {
            "fabricImgPath": "/editor/assets/comparenumbers.png"
        },
        "menu": [],
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
