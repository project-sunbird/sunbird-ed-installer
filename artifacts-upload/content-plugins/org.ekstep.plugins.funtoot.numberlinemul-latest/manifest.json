{
    "id": "org.ekstep.plugins.funtoot.numberlinemul",
    "ver": "1.0",
    "author": "funtoot",
    "type": "plugin",
    "title": "NumberlineMultiplication",
    "description": "NumberlineMultiplication",
    "editor": {
        "main": "editor/plugin.js",
        "wizard": {
            "configFile": {
                "path": "editor/configs.json"
            },
            "i18nFile": {
                "pluginId": "org.ekstep.plugins.funtoot.numberlinebase"
            },
            "localeFile": {
                "pluginId": "org.ekstep.plugins.funtoot.numberlinebase",
                "path": "editor/i18n.json"
            },
            "fbImage": {
                "pluginId": "org.ekstep.plugins.funtoot.numberlinebase"
            }
        },
        "assets": {
            "fabricImgPath": "/editor/assets/Numberline.png"
        },
        "menu": [
            {
                "id": "org.ekstep.plugins.funtoot.numberlinemul::menu",
                "category": "main",
                "type": "icon",
                "toolTip": "Add Numberline Multiplication",
                "title": "NumberlineMultiplication",
                "iconClass": "icon-readalong icon",
                "onclick": {
                    "id": "org.ekstep.plugins.funtoot.numberlinemul:showpopup"
                }
            }
        ],
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
                "dataType": "rangeslider",
                "valueType": "text",
                "required": true,
                "minimumValue": 1,
                "maximumValue": 10
            }
        ]
    },
    "renderer": {
        "main": "renderer/plugin.js"
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.plugins.funtoot.numberlinebase",
            "ver": "1.0",
            "type": "plugin",
            "scope": "all"
        }
    ]
}