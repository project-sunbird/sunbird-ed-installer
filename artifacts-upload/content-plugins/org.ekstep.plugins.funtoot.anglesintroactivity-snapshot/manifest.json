{
    "id": "org.ekstep.plugins.funtoot.anglesintroactivity",
    "ver": "1.0",
    "author": "Amulya",
    "type": "plugin",
    "title": "anglesintro",
    "description": "angles introduction",
    "editor": {
        "main": "editor/plugin.js",
        "wizard": {
            "filter": "editor/filters.json"
        },
        "assets": {
            "fabricImgPath": "/editor/assets/anglesintroduction.png"
        },
        "menu": [
            {
                "id": "anglesintro",
                "category": "main",
                "type": "icon",
                "toolTip": "Add Introduction to Angles",
                "title": "angles introduction",
                "iconClass": "icon-readalong icon",
                "onclick": {
                    "id": "org.ekstep.plugins.funtoot.anglesintroactivity:showpopup"
                }
            }
        ],
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
                "dataType": "rangeslider",
                "valueType": "text",
                "required": true,
                "minimumValue": 1,
                "maximumValue": 10
            }
        ]
    },
    "renderer": {
        "main": "renderer/plugin.js"
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.plugins.funtoot.activitybase",
            "ver": "1.0",
            "type": "plugin",
            "scope": "all"
        }
    ]
}