{
    "id": "org.ekstep.plugins.myplugin",
    "ver": "1.0",
    "author": "Jagadish",
    "title": "Add question",
    "description": "",
    "publishedDate": "",
    "icon": "assets/icon.png",
    "languages": ["English"],
    "categories": [],
    "keywords": ["myPlugin"],
    "editor": {
        "main": "editor/plugin.js",
        "dependencies": [
            { "type": "js", "src": "editor/init.js" },
            { "type": "js", "src": "editor/createquestionapp.js" },
            { "type": "plugin", "plugin": "org.ekstep.image", "ver": "1.1" },
            { "type": "plugin", "plugin": "org.ekstep.audio", "ver": "1.1" }
        ],
        "menu": [{
            "id": "createquestion",
            "category": "main",
            "type": "image",
            "toolTip": "Create Question",
            "title": "createQuestion",
            "iconImage": "assets/createQuestion.png",
            "onclick": {
                 "id": "org.ekstep.plugins.myplugin:showpopup",
                "data": {
                    "type": "roundrect",
                    "x": 5,
                    "y": 5,
                    "fill": "#0000",
                    "w": 90,
                    "h": 90,
                    "radius": 10,
                    "stroke": "rgba(255, 255, 255, 255)",
                    "strokeWidth": 1,
                    "opacity": 0.01
                }
            }
        }],
        "init-data": {
            "type": "rect",
            "x": 10,
            "y": 2,
            "w": 80,
            "h": 80,
            "fill": "#DCDCDC"
        },
        "configManifest": [{

        }],
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        }
    },
    "renderer": 
       {
        "main": "renderer/plugin.js",
        "dependencies": [
        {
            "type": "css",
            "src": "renderer/libs/style.css"
        },
         {
            "type": "css",
            "src": "renderer/libs/magnific-popup.css"
        },
        {
            "type": "js",
            "src": "renderer/libs/jquery.magnific-popup.js"
        }


        ]
    }
}
