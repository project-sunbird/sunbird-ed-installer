{
    "id": "org.ekstep.plugins.funtoot.timeclockintro",
    "ver": "1.0",
    "author": "funtoot",
    "type": "plugin",
    "title": "timeclockintro",
    "description": "This plgin is used to generate  clock based questions.",
    "editor": {
        "main": "editor/plugin.js",
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "wizard": {
            "controller": "editor/timeclockintro.js",
            "template": "editor/timeclockintro.html"
        },
        "menu": [{
            "id": "timeintrocustom",
            "category": "main",
            "type": "icon",
            "toolTip": "Add A Clock",
            "title": "Clock Intro",
            "iconClass": "icon-readalong icon",
            "onclick": {
                "id": "org.ekstep.plugins.funtoot.timeclockintro:showpopup"
            }
        }],
        "configManifest": [{
            "propertyName": "count",
            "title": "Number of Questions",
            "description": "Number of Questions",
            "dataType": "rangeslider",
            "valueType": "text",
            "required": true,
            "minimumValue": 1,
            "maximumValue": 10
        }]
    },
    "renderer": {
        "main": "renderer/plugin.js"
    },
    "dependencies": [{
        "plugin": "org.ekstep.funtoot.common",
        "ver": "1.0",
        "type": "plugin",
        "scope": "all"
    }]
}