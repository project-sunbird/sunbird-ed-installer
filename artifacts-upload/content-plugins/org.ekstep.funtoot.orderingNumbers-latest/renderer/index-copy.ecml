      <data>
<![CDATA[{
    "identifier": "reordering_letter_one_word",
    "title": "Reordering letter one word",
    "total_items": 2,
    "shuffle": false,
    "max_score": 1,
    "subject": "LIT",
    "item_sets": [{
        "id": "set_1",
        "count": 2
    }],
    "items": {
        "set_1": [{
                "identifier": "reord.q1",
                "type": "mtf",
                "langid": "en",
                "template_id": "",
                "template": "",
                "title": "Arrange the numbers",
                "question": "The HTML DOM can be accessed with JavaScript (and with other programming languages).",
                "question_image": "esl",
                "question_audio": "",
                "question_count": "",
                "order": "ascending",
                "model": {},
                "max_score": 1,
                "feedback": "true",
                "keywords": ["array", "of", "strings"],
                "variables":{
                    "$x": "generateNumber('[0 - 1]')",
                    "$y": "generateNumber('[2 - 3]')",
                    "$z": "generateNumber('[4 - 5]')",
                    "$a": "generateNumber('[6 - 7]')",
                    "$b": "generateNumber('[8 - 9]')",
                    "$n1": "$x*10+$b",
                    "$n2": "$y*10+$b",
                    "$n3": "$z*10+$b",
                    "$n4": "$a*10+$b",
                    "$n5": "$b*10+$b"
                }
            }
        ]
    },
    "i18n": {
        "en": {
            "GREATER_THAN_9999_ASCENDING": "Check the place value of the given numbers and carefully arrange them in increasing order.",
            "GREATER_THAN_9999_DESCENDING": "Check the place value of the given numbers and carefully arrange them in decreasing order.",
            "LESSER_THAN_9999_ASCENDING": "Use the number sequence and arrange them in increasing order carefully.",
            "LESSER_THAN_9999_DESCENDING": "Take the given number sequence and carefully arrange them in decreasing order." 
        }
    }}
]]>
      </data>
      <config>
        <![CDATA[{"title":"Fill in the missing numbers","count":2,"type":"items","var":"item"}]]>
      </config>
    </org.ekstep.funtoot.orderingNumbers>
