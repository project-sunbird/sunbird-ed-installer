{
    "id": "org.ekstep.funtoot.numeralscountingbase",
    "ver": "1.0",
    "author": "Sandhya M",
    "title": "Number Counting",
    "description": "",
    "publishedDate": "",
    "editor": {
        "main": "editor/plugin.js",
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "wizard": {
            "controller": "editor/numerals.counting.js",
            "template": "editor/numerals.counting.html"
        },
        "assets": {
            "fabricImgPath": "/editor/assets/missingnumbersinsequence.png"
        },
        "menu": [],
        "configManifest": [
            {
                "propertyName": "count",
                "title": "Number of Questions",
                "description": "Number of Questions",
                "dataType": "rangeslider",
                "valueType": "text",
                "required": true,
                "minimumValue": 1,
                "maximumValue": 10
            }
        ]
    },
    "renderer": {
        "main": "renderer/numeralscounting.js",
        "dependencies": [
            {
                "id": "tile3x3",
                "src": "asset/tile3x3.png",
                "type": "image"
            },
            {
                "id": "tile3x4",
                "src": "asset/tile3x4.png",
                "type": "image"
            }
        ]
    },
    "dependencies": [
        {
            "plugin": "org.ekstep.funtoot.common",
            "ver": "1.0",
            "type": "plugin",
            "scope": "all"
        }
    ]
}