,"identifier":"compare_numbers","qid":"org.ekstep.funtoot.compareNumbers-g1-l0-sl0","subject":"NUM","grade":"1","gradeLevel":["Grade 1"],"bloomsTaxonomyLevel":"R","level":0,"sublevel":0,"qindex":"","qlevel":"EASY","type":"mtf","template_id":"","template":"compareNumbers","title":"Compare the numbers","question_audio":"","question_image":"","model":{"numbers":"$nums","numericLangId":"en","langId":"en","numberType":"","hintMsg":"HINT041_DIGITS","variables":{"$a":"generateNumber('[1 - 9]')","$b":"generateNumber('[1 - 9]')","$n1":"[$a]","$n2":"$a*10+$b"}},"concepts":{"identifier":"C6","name":"Counting"}},{"langid":"en","language":["English"],"identifier":"compare_numbers","qid":"org.ekstep.funtoot.compareNumbers-g1-l0-sl0","subject":"NUM","grade":"1","gradeLevel":["Grade 1"],"bloomsTaxonomyLevel":"R","level":0,"sublevel":0,"qindex":"","qlevel":"EASY","type":"mtf","template_id":"","template":"compareNumbers","title":"Compare the numbers","question_audio":"","question_image":"","model":{"numbers":"$nums","numericLangId":"en","langId":"en","numberType":"","hintMsg":"HINT041_DIGITS","variables":{"$a":"generateNumber('[1 - 9]')","$b":"generateNumber('[1 - 9]')","$n1":"[$a]","$n2":"$a*10+$b"}},"concepts":{"identifier":"C6","name":"Counting"}}]},"i18n":{"en":{"GENERIC_ERROR":"Look at the number sequence carefully and write the missing number.","EVEN_ARRAY_NOT_MASKED_ALTERNATELY":"Look at the difference between the given even numbers and carefully find the missing numbers.","ODD_ARRAY_NOT_MASKED_ALTERNATELY":"Look at the difference between the given numbers and carefully find the missing numbers.","ARRAY_WHICH_IS_MULTIPLE_OF_SKIP_NUMBER":"Look at the difference between the given numbers and carefully find the multiples of the missing numbers.","ARRAY_WHICH_IS_NOT_MULTIPLE_OF_SKIP_NUMBER":"Look at the difference between the given numbers and carefully find the missing numbers.","NO_ANSWER":"Please answer.","NO_HINT":"There is no hint for this question.","HINT051_VALUE":"Check the place value of each digit in the numbers and then carefully order them in sequence.","QUESTION05_STEM":"Rearrange the given numbers in ascending / descending order.","GREATER_THAN_9999_ASCENDING":"Check the place value of the given numbers and carefully arrange them in increasing order.","GREATER_THAN_9999_DESCENDING":"Check the place value of the given numbers and carefully arrange them in decreasing order.","LESSER_THAN_9999_ASCENDING":"Use the number sequence and arrange them in increasing order carefully.","LESSER_THAN_9999_DESCENDING":"Take the given number sequence and carefully arrange them in decreasing order.","GREATER_THAN_999":"Check the place value of every digit and carefully insert the symbol.","LESSER_THAN_999":"Recall the number sequence and carefully insert the symbol."},"kn":{"GENERIC_ERROR":"ಎಚ್ಚರಿಕೆಯಿಂದ ಸಂಖ್ಯೆ ಅನುಕ್ರಮ ನೋಡಲು ಮತ್ತು ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಯನ್ನು ಬರೆಯಿರಿ.","EVEN_ARRAY_NOT_MASKED_ALTERNATELY":"ನೀಡಿದ ಸಹ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು.","ODD_ARRAY_NOT_MASKED_ALTERNATELY":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು.","ARRAY_WHICH_IS_MULTIPLE_OF_SKIP_NUMBER":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ದ್ವಿಗುಣ ಹೇಗೆ.","ARRAY_WHICH_IS_NOT_MULTIPLE_OF_SKIP_NUMBER":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ನೋಡಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಕಾಣೆಯಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು.","NO_ANSWER":"ದಯವಿಟ್ಟು ಉತ್ತರಿಸಿ.","NO_HINT":"ಈ ಪ್ರಶ್ನೆಗೆ ಯಾವುದೇ ಸುಳಿವು ಇಲ್ಲ.","HINT031_SKIPCOUNT":"ನೀಡಿದ ಸಂಖ್ಯೆಗಳ ನಡುವೆ ವ್ಯತ್ಯಾಸವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ನಂತರ ಕಾಣೆಯಾಗಿದೆ ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ ಸಂಖ್ಯೆಗಳನ್ನು ಲೆಕ್ಕಾಚಾರ.","QUESTION03_STEM1":"ಖಾಲಿ ಸ್ಥಾನಗಳು ಎಣಿಕೆಯ ಫಿಲ್ ತೆರಳಿ ಬಳಸಿ"},"hi":{"GENERIC_ERROR":"नंबर अनुक्रम को सावधानी से देखो और लापता संख्या लिखें।","EVEN_ARRAY_NOT_MASKED_ALTERNATELY":"दी गई संख्याओं के बीच के अंतर को देखो और ध्यान से लापता संख्याओं को ढूंढें।","ODD_ARRAY_NOT_MASKED_ALTERNATELY":"दिए गए संख्याओं के बीच के अंतर को देखें और लापता संख्याओं को ध्यान से ढूंढें।","ARRAY_WHICH_IS_MULTIPLE_OF_SKIP_NUMBER":"दी संख्याओं के बीच के अंतर को देखें और ध्यान से गुम संख्याओं के गुणकों को ढूंढें।","ARRAY_WHICH_IS_NOT_MULTIPLE_OF_SKIP_NUMBER":"दिए गए संख्याओं के बीच के अंतर को देखें और लापता संख्याओं को ध्यान से ढूंढें।","NO_ANSWER":"कृपया उत्तर दीजिये।","NO_HINT":"इस सवाल का कोई संकेत नहीं है","HINT031_SKIPCOUNT":"दिए गए संख्याओं के बीच अंतर की जांच करें और फिर याद किए गए छोड़े गए नंबरों की गणना करें।","QUESTION03_STEM1":"रिक्त संख्या में भरने के लिए छोड़ने का उपयोग करना"}},"selectedConfig":{"Type":"Comparing numbers","Grade":"1, 2","Level":0,"LevelDescShown":"Comparing 2 numbers","SubLevel":0,"SubLevelDescShown":"Single and 2 digit number comparison","Expression":"$a = [1 - 9]\n$b = [1 - 9]\n$n1 = [$a]\n$n2 = $a*10+$b","BTLO":"R","DifficultyLevel":1,"Description":"Tests the difference between single and 2 digit numbers.","SubLevelDesc":"Single and 2 digit number","HintID":"HINT041_DIGITS","QuestionText":"QUESTION04_STEM","QID":"","Subject":"NUM","ConceptCode":"C226, C484","ESDifficultyLevel":"","ConceptName":"","":2,"selectedGrade":"1","QCount":"8"}}]]>
