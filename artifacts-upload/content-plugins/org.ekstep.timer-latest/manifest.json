{
    "id": "org.ekstep.timer",
    "ver": "1.0",
    "author": "Srivathsa Dhanraj",
    "title": "Timer Plugin",
    "description": "",
    "publishedDate": "",
    "type":"plugin",
    "editor": {
        "main": "editor/plugin.js",
        "dependencies": [
            
        ],
        "menu": [{
            "id": "timer",
            "category": "main",
            "type": "icon",
            "toolTip": "Add Timer",
            "title": "Timer",
            "iconClass": "alarm icon",
            "onclick": {
                    "id": "org.ekstep.timer:create",
                    "data": {
                        "x": 12,
                        "y": 2,
                        "fontfamily": "Arial",
                        "fontSize": 20,
                        "w": 15,
                        "h": 8,
                        "name":"timer1",
                        "type":"CountDown",
                        "unit":"Seconds",
                        "time":5,
                        "alertTime":3,
                        "toStageId":1,
                        "color":"#000000"
                    }
                }
            
        }],
        "configManifest": [
            {
                "propertyName": "name",
                "title": "Name",
                "placeholder": "Name",
                "description": "Id for the timer",
                "dataType": "input",
                "valueType": "text",
                "required": true,
                "defaultValue": "timer1"
            },
            {
                "propertyName": "unit",
                "title": "Unit",
                "description": "Unit",
                "dataType": "select",
                "range": ["Minutes","Seconds"],
                "required": true,
                "defaultValue": "Minutes"
            },
            {
                "propertyName": "time",
                "title": "Time",
                "placeholder": "Time",
                "description": "Time to count down from",
                "dataType": "input",
                "valueType": "number",
                "minimumValue":0,
                "required": true,
                "defaultValue": "5"
            },
            {
                "propertyName": "alertTime",
                "title": "AlertTime",
                "placeholder": "Alert Time",
                "description": "Time to start alert",
                "dataType": "input",
                "valueType": "number",
                "minimumValue":0,
                "required": true,
                "defaultValue": 1
            },
            {
                "propertyName": "type",
                "title": "Type",
                "description": "Countdown or countup?",
                "dataType": "select",
                "range": ["CountDown","CountUp"],
                "required": true,
                "defaultValue": "CountDown"
            },
            {
                "propertyName": "fontfamily",
                "title": "Font Family",
                "description": "Select font family for the text",
                "dataType": "select",
                "range": ["Arial", "Courier", "Georgia", "Helvetica", "Monospace", "Sans-serif", "Serif", "Tahoma", "Times", "Trebuchet MS", "Verdana", "NotoSansKannada", "NotoSansGujarati", "NotoSansBengali", "NotoSansGurmukhi", "NotoSansOriya", "NotoSansDevanagari", "NotoSansTamil", "NotoSansTelugu", "NotoNastaliqUrdu", "NotoSansMalayalam"],
                "required": true,
                "defaultValue": "Arial"
            },
            {
                "propertyName": "fontSize",
                "title": "Font Size",
                "placeholder": 20,
                "description": "Font size",
                "dataType": "input",
                "valueType": "number",
                "required": true,
                "defaultValue": 20
            },
            {
                "propertyName": "color",
                "title": "Text Color",
                "description": "Choose a color from the color picker",
                "dataType": "colorpicker",
                "required": true,
                "defaultValue": "#000000"
            }
            
        ],
        "help": {
            "src": "editor/help.md",
            "dataType": "text"
        },
        "init-data": {
            "x": 12,
            "y": 2,
            "fontfamily": "Arial",
            "fontSize": 20,
            "w": 15,
            "h": 8,
            "name":"timer1",
            "type":"CountDown",
            "unit":"Seconds",
            "time":5,
            "alertTime":3,
            "toStageId":1,
            "color":"#000000"
        }
    },
    "renderer": {
        "main": "renderer/timer.js"
    }
}
